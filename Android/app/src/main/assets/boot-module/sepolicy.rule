# Droidspaces SELinux policy - Magisk/KernelSU/APatch module format
# Copyright (C) 2026 ravindu644 <droidcasts@protonmail.com>
# SPDX-License-Identifier: GPL-3.0-or-later

# Type declarations
type droidspacesd domain
type ksu domain
type magisk domain
type su domain
type droidspacesd_exec exec_type
permissive droidspacesd

# droidspacesd_exec
allow droidspacesd_exec droidspacesd_exec file { entrypoint execute execute_no_trans getattr map open read relabelfrom relabelto }
allow droidspacesd_exec labeledfs filesystem associate

# init
allow init droidspacesd process { noatsecure rlimitinh siginh transition }
allow init droidspacesd process2 nosuid_transition
allow init droidspacesd_exec file { execute getattr map open read }
allow init droidspacesd_exec lnk_file { getattr read }
allow init system_data_file file { execute getattr map open read }

# kernel
allow kernel device blk_file { create getattr setattr unlink }
allow kernel device chr_file { create setattr }
allow kernel device dir { add_name write }
allow kernel droidspacesd fd use
allow kernel system_data_file file { getattr open read write }
allow kernel vold_data_file file { getattr open read write }

# magisk
allow magisk droidspacesd process { dyntransition noatsecure rlimitinh siginh transition }
allow magisk droidspacesd process2 nosuid_transition
allow magisk droidspacesd_exec file { entrypoint execute execute_no_trans getattr map open read relabelfrom relabelto }
allow magisk system_data_file file entrypoint

# netd
allow netd proc_net dir add_name
allow netd proc_net file create

# ksu
allow ksu droidspacesd process { dyntransition noatsecure rlimitinh siginh transition }
allow ksu droidspacesd process2 nosuid_transition
allow ksu droidspacesd_exec file { entrypoint execute execute_no_trans getattr map open read relabelfrom relabelto }
allow ksu system_data_file file entrypoint

# servicemanager
allow servicemanager droidspacesd binder { call transfer }
allow servicemanager droidspacesd dir search
allow servicemanager droidspacesd file { getattr open read }
allow servicemanager droidspacesd process getattr

# hwservicemanager hands HIDL service handles (the gralloc allocator, for
# libhybris in GPU mode) to container processes
allow hwservicemanager droidspacesd binder transfer

# su
allow su droidspacesd process { dyntransition noatsecure rlimitinh siginh transition }
allow su droidspacesd process2 nosuid_transition
allow su droidspacesd_exec file { entrypoint execute execute_no_trans getattr map open read relabelfrom relabelto }
allow su system_data_file file entrypoint

# system_server
allow system_server droidspacesd binder { call transfer }
allow system_server droidspacesd fd use
allow system_server droidspacesd fifo_file write

# for Termux:X11 and DRI3 denials in daemon mode
allow untrusted_app_27 droidspacesd fd use
allow untrusted_app_27 droidspacesd fifo_file write

# for pulseAudio
allow audioserver droidspacesd binder { call transfer }
allow audioserver droidspacesd fd use
allow mediaserver droidspacesd binder { call transfer }
allow mediaserver droidspacesd fd use

# fix permission denied when read/write mounted storage (#213)
allow mediaprovider_app droidspacesd fd use

# for anland
allow untrusted_app droidspacesd fd use
allow surfaceflinger droidspacesd fd use
allow hal_graphics_composer_default droidspacesd fd use
allow untrusted_app su unix_stream_socket { read write }

# ---------------------------------------------------------------------------
# Suppress the expected denials of the permissive container domain.
#
# droidspacesd is permissive: accesses the policy does not allow are still
# permitted, but SELinux writes an AVC record for each one.  Inside a
# container that is thousands of records per minute.  On kernels with a small
# audit backlog (audit_backlog_limit=64 on many Android kernels)
# audit_log_start() sleeps waiting for kauditd to drain the queue, which can
# freeze the whole device (hard reset by the PMIC watchdog).
#
# These rules only drop the audit record for this domain; the permission
# decision is unchanged and other domains keep logging normally.  The
# signatures below were collected from the actual crash logs.
# ---------------------------------------------------------------------------
dontaudit droidspacesd app_data_file:dir { add_name remove_name search write };
dontaudit droidspacesd app_data_file:file { create getattr open rename write };
dontaudit droidspacesd app_data_file:sock_file { write };
dontaudit droidspacesd audio_service:service_manager { find };
dontaudit droidspacesd audioserver_service:service_manager { find };
dontaudit droidspacesd cgroup_v2:dir { add_name create open read remove_name rmdir search setattr write };
dontaudit droidspacesd cgroup_v2:file { getattr open read watch write };
dontaudit droidspacesd cgroup:dir { search };
dontaudit droidspacesd device_config_service:service_manager { find };
dontaudit droidspacesd deviceidle_service:service_manager { find };
dontaudit droidspacesd devpts:chr_file { getattr ioctl lock open read write };
dontaudit droidspacesd droidspacesd_exec:file { entrypoint execute execute_no_trans map open read };
dontaudit droidspacesd fuse:filesystem { mount };
dontaudit droidspacesd mediametrics_service:service_manager { find };
dontaudit droidspacesd node:udp_socket { node_bind };
dontaudit droidspacesd port:tcp_socket { name_connect };
dontaudit droidspacesd proc_cmdline:file { read };
dontaudit droidspacesd proc_filesystems:file { getattr open read };
dontaudit droidspacesd proc_meminfo:file { open read };
dontaudit droidspacesd proc_net:file { getattr open read };
dontaudit droidspacesd proc_overcommit_memory:file { open read };
dontaudit droidspacesd proc_stat:file { getattr open read };
dontaudit droidspacesd proc:file { getattr ioctl open read };
dontaudit droidspacesd sysfs_thermal:dir { open read search };
dontaudit droidspacesd sysfs_thermal:file { read };
dontaudit droidspacesd sysfs:file { getattr open read };
dontaudit droidspacesd system_data_file:blk_file { create unlink };
dontaudit droidspacesd system_data_file:dir { add_name getattr ioctl open read remove_name search write };
dontaudit droidspacesd system_data_file:file { append create execute execute_no_trans getattr ioctl map open read rename setattr unlink write };
dontaudit droidspacesd system_data_file:lnk_file { create getattr read unlink };
dontaudit droidspacesd tmpfs:chr_file { getattr ioctl lock map open read write };
dontaudit droidspacesd tmpfs:dir { add_name create read remove_name rmdir watch write };
dontaudit droidspacesd tmpfs:file { create getattr ioctl lock open read rename setattr unlink watch write };
dontaudit droidspacesd tmpfs:lnk_file { create getattr read rename unlink };
dontaudit droidspacesd tmpfs:sock_file { create write };
dontaudit droidspacesd unlabeled:file { getattr open read };
dontaudit droidspacesd unlabeled:filesystem { getattr };
dontaudit droidspacesd vendor_sysfs_data:dir { search };
dontaudit droidspacesd vendor_sysfs_data:file { getattr open read };
dontaudit droidspacesd vendor_sysfs_graphics:dir { search };
dontaudit droidspacesd vendor_sysfs_graphics:file { getattr open read };
dontaudit droidspacesd vendor_sysfs_usb_supply:dir { search };
dontaudit droidspacesd vendor_sysfs_usb_supply:file { getattr open read };
